# Copy to .env and fill in. .env is git-ignored and never read by the build agent directly.
HERO_ANTHROPIC_API_KEY=          # Anthropic key for the street-generation pipeline (vision + review)
HERO_ANTHROPIC_WORKSPACE_ID=     # required: workspace the key is scoped to (sent as anthropic-workspace-id header)
HERO_GOOGLE_MAPS_API_KEY=        # Google Maps Platform key with Static Maps + Street View Static enabled
HERO_CLAUDE_BUDGET_USD=50        # hard stop for cumulative generation spend
HERO_RUN_BUDGET_USD=1.00         # per-run Claude hard stop, checked before every call (Phase 2 default; typical dense run $0.25-0.50)
HERO_ADMIN_PASSWORD=             # admin area password, sent as X-Hero-Admin-Password header
HERO_HOST=0.0.0.0                # bind address
HERO_PORT=8711                   # bind port
HERO_DATABASE_URL=sqlite:///data/hero.db          # production DB (SQLite file)
HERO_TEST_DATABASE_URL=sqlite:///data/hero_test.db # test DB base name; tests/conftest.py appends the pid (data/hero_test_<pid>.db) and removes it
HERO_DATA_DIR=data               # imagery/osm cache, previews, crops
HERO_VISION_MODEL=claude-sonnet-5-5   # perception passes (default lives in src/hero/llm/defaults.py)
HERO_REVIEW_MODEL=claude-sonnet-5-5   # critique loop (default lives in src/hero/llm/defaults.py)
HERO_MAX_REVIEW_ITERATIONS=1     # bounded reflection (critique of the model render)
HERO_LLM_PRICE_TABLE=src/hero/llm/prices.json   # {model: {input_usd_per_mtok, output_usd_per_mtok}}
HERO_OVERPASS_URL=https://overpass-api.de/api/interpreter   # OSM
HERO_SATELLITE_ZOOM=19           # Static Maps zoom (640x640 @ scale 2)
HERO_STREETVIEW_SAMPLES=3        # Phase-1 legacy pipeline only: panoramas per segment (0 m, mid, end)
HERO_SV_SPACING_M=10             # Phase 2: Street View station spacing along the reference line (4-40)
HERO_SV_HEADINGS=forward,back,left,right   # Phase 2: headings per station, relative to the road tangent (forward|back|left|right)
HERO_SAT_CROP_ZOOM=20            # Phase 2: zoom of the close-up satellite crops (18-21)
HERO_SAT_CROP_SPACING_M=40       # Phase 2: spacing of close-up crop centres
HERO_MAX_IMAGES_PER_RUN=60       # Phase 2: cap on NEW paid Google image requests per run (planner widens spacing to fit)
HERO_PERCEPTION_BATCH_IMAGES=8   # Phase 2: images per perception call (fewer, richer calls)
HERO_STRUCTURED_MODE=auto        # Phase 2: auto|forced_tool|auto_tool|json_text (structured-output mode for the model)
HERO_UPLOAD_MAX_MB=10            # Phase 2: max size of an uploaded observation photo
HERO_LOG_LEVEL=INFO
