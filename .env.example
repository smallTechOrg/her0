# Copy to .env and fill in. .env is git-ignored and never read by the build agent directly.
HERO_ANTHROPIC_API_KEY=          # Anthropic key for the street-generation pipeline (vision + review)
HERO_ANTHROPIC_WORKSPACE_ID=     # required: workspace the key is scoped to (sent as anthropic-workspace-id header)
HERO_GOOGLE_MAPS_API_KEY=        # Google Maps Platform key with Static Maps + Street View Static enabled
HERO_CLAUDE_BUDGET_USD=50        # hard stop for cumulative generation spend
HERO_RUN_BUDGET_USD=2.00         # per-run hard stop (safety against a runaway loop)
HERO_ADMIN_PASSWORD=             # admin area password, sent as X-Hero-Admin-Password header
HERO_HOST=0.0.0.0                # bind address
HERO_PORT=8711                   # bind port
HERO_DATABASE_URL=sqlite:///data/hero.db          # production DB (SQLite file)
HERO_TEST_DATABASE_URL=sqlite:///data/hero_test.db # test DB, created/dropped by tests/conftest.py
HERO_DATA_DIR=data               # imagery/osm cache, previews, crops
HERO_VISION_MODEL=claude-sonnet-4-5   # vision passes A and B
HERO_REVIEW_MODEL=claude-sonnet-4-5   # review loop
HERO_MAX_REVIEW_ITERATIONS=2     # bounded reflection
HERO_LLM_PRICE_TABLE=src/hero/llm/prices.json   # {model: {input_usd_per_mtok, output_usd_per_mtok}}
HERO_OVERPASS_URL=https://overpass-api.de/api/interpreter   # OSM
HERO_SATELLITE_ZOOM=19           # Static Maps zoom (640x640 @ scale 2)
HERO_STREETVIEW_SAMPLES=3        # panoramas per segment (0 m, mid, end)
HERO_LOG_LEVEL=INFO
